{
  "name": "ai-virtual-phone",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "node --max-old-space-size=4096 scripts/local-next-server.mjs --dev",
    "build": "node scripts/build-weixin-assistant-dist.mjs && node scripts/build-personal-push-dist.mjs && next build && node scripts/restore-backdrop-filter.mjs",
    "start": "node scripts/local-next-server.mjs --prod",
    "lint": "next lint",
    "test": "npm run test:memory-compat && npm run test:memory-extraction && npm run test:future-intent-detector && npm run test:future-intent-lifecycle && npm run test:core-memory-builder && npm run test:memory-retrieval && npm run test:memory-ranking && npm run test:memory-recall-stats && npm run test:memory-debug && npm run test:prompt-recall-gate && npm run test:migration-foundation",
    "test:memory-compat": "node scripts/test-memory-compat.mjs",
    "test:memory-extraction": "node scripts/test-memory-extraction.mjs",
    "test:future-intent-detector": "node scripts/test-future-intent-detector.mjs",
    "test:future-intent-lifecycle": "node scripts/test-future-intent-lifecycle.mjs",
    "test:core-memory-builder": "node --no-warnings --experimental-vm-modules scripts/test-core-memory-builder.mjs",
    "test:memory-retrieval": "node --no-warnings --experimental-vm-modules scripts/test-memory-retrieval.mjs",
    "test:memory-ranking": "node scripts/test-memory-ranking.mjs",
    "test:memory-recall-stats": "node --no-warnings --experimental-vm-modules scripts/test-memory-recall-stats.mjs",
    "test:memory-debug": "node --no-warnings --experimental-vm-modules scripts/test-memory-debug.mjs",
    "test:prompt-recall-gate": "node --no-warnings --experimental-vm-modules scripts/test-prompt-recall-gate.mjs",
    "test:migration-foundation": "node scripts/test-migration-foundation.mjs",
    "check:sdk": "node scripts/check-custom-app-sdk-consistency.mjs",
    "check:weixin": "node scripts/check-weixin-prompt-equivalence.mjs",
    "check:push": "node scripts/check-personal-push-dist.mjs",
    "weixin:assistant": "node tools/weixin-local-assistant/assistant.mjs",
    "weixin:assistant:once": "node tools/weixin-local-assistant/assistant.mjs --once",
    "weixin:build-dist": "node scripts/build-weixin-assistant-dist.mjs",
    "push:build-dist": "node scripts/build-personal-push-dist.mjs",
    "build:glass-icons": "node scripts/build-glass-icons.mjs"
  },
  "dependencies": {
    "@gltf-transform/functions": "^4.4.1",
    "@heroicons/react": "^2.2.0",
    "@mdi/js": "^7.4.47",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@supabase/realtime-js": "^2.110.7",
    "@types/three": "^0.183.1",
    "@types/web-push": "^3.6.4",
    "d3-delaunay": "^6.0.4",
    "dexie": "^4.3.0",
    "dompurify": "^3.3.3",
    "jsonrepair": "^3.13.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.575.0",
    "marked": "^17.0.4",
    "next": "^15.1.0",
    "pinyin-pro": "^3.28.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.183.2",
    "undici": "^7.26.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/d3-delaunay": "^6.0.4",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.2"
  }
}
